{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task journal event",
  "type": "object",
  "required": [
    "seq",
    "id",
    "task",
    "generation",
    "actor",
    "at",
    "kind",
    "data"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
