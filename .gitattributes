* text=auto eol=lf
# cmd.exe needs CRLF to parse labels and goto reliably.
*.cmd text eol=crlf

# Keep tests, validation tooling and CI in the repository, out of release archives.
.github export-ignore
.gitattributes export-ignore
scripts/test_*.py export-ignore
scripts/check_encoding.py export-ignore
scripts/validate_native.py export-ignore
docs/images/generate.py export-ignore
